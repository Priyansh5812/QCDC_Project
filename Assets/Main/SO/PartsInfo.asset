%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96179ead63690564fb7d62de5287f1dd, type: 3}
  m_Name: PartsInfo
  m_EditorClassIdentifier: 
  descReg:
    _serializedList:
    - Key: 0
      Value:
        partName: Female Tank End Assembly
        description: The receiving side of the coupling mounted on the tank. It houses
          internal components that guide alignment and enable secure engagement with
          the male counterpart.
    - Key: 3
      Value:
        partName: Female Flap
        description: A movable internal valve that controls flow. It opens during
          connection and seals the system when disconnected to prevent leakage.
    - Key: 2
      Value:
        partName: Female End Spring
        description: A compression spring that pushes the flap into a closed position
          when the coupling is disengaged, ensuring automatic sealing.
    - Key: 1
      Value:
        partName: Female Flap End
        description: The sealing edge of the flap that ensures tight closure, maintaining
          pressure integrity and preventing fluid escape.
    - Key: 4
      Value:
        partName: Protection Rings
        description: Outer rings that shield the coupling components from impact,
          wear, and environmental damage.
    - Key: 5
      Value:
        partName: Hose Unit Product
        description: The flexible conduit attached to the male assembly, responsible
          for transporting fluid between systems.
    - Key: 6
      Value:
        partName: Inside Rings
        description: Internal sealing or guiding rings that ensure proper alignment,
          reduce friction, and maintain leak-proof operation.
    - Key: 8
      Value:
        partName: Handle
        description: An external control used to engage or disengage the coupling.
          It operates the internal locking and valve mechanisms.
    - Key: 7
      Value:
        partName: Male Flap
        description: A corresponding valve that interacts with the female flap. It
          opens during connection to allow flow and closes when separated.
    - Key: 9
      Value:
        partName: Male Tank End Assembly
        description: The connecting side attached to the hose or external system.
          It interfaces with the female assembly to establish flow and mechanical
          locking.
